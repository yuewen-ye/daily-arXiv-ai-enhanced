# Fill these locally in .env; for Actions use repository Secrets.
ZOTERO_ID=
ZOTERO_KEY=
DEEPSEEK_API_KEY=

# Optional repository Variables / local environment defaults
CATEGORIES=cs.CV,cs.LG,cs.AI,cs.CL
DEEPSEEK_MODEL=deepseek-flash
SUMMARY_LIMIT=50
EMBEDDING_MODEL=jinaai/jina-embeddings-v5-text-nano-retrieval
# JSON lists of full collection paths; ** spans nested collections.
ZOTERO_INCLUDE_PATHS=null
ZOTERO_IGNORE_PATHS=null
